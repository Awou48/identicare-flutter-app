# Copy to .env and adjust. .env is gitignored.
IDENTICARE_ENV=dev

# --- MongoDB ---
MONGO_URI=mongodb://identicare:identicare@localhost:27017/?authSource=admin
MONGO_DB=identicare

# --- Key material (generate with: python scripts/gen_keys.py) ---
KEK_PATH=./keys/kek.bin
ROTATION_PATH=./keys/rotation_v1.npy
# Pepper for NIK hashing. Lives in env, never in the database — otherwise a dump
# lets an attacker brute-force all 16-digit NIKs offline in seconds.
NIK_PEPPER=CHANGE_ME_generate_with_gen_keys

# --- Face models (download into ./models, see README.md) ---
FACE_DET_MODEL=./models/det_500m.onnx
FACE_REC_MODEL=./models/w600k_r50.onnx
FACE_EMBEDDING_DIM=512

# --- Thresholds. Tunable without a redeploy; calibrate before demoing. ---
FACE_MATCH_ACCEPT=0.42
FACE_MATCH_REVIEW=0.30
FACE_COLLISION_THRESHOLD=0.55
LIVENESS_MIN_SCORE=0.70
FACE_MAX_ATTEMPTS=3

# --- Sessions ---
SESSION_TTL_SECONDS=600
NONCE_TTL_SECONDS=120

# --- Auth ---
# Enough on its own to verify Firebase ID tokens (Google public keys).
FIREBASE_PROJECT_ID=identicare-591e3
# Optional. Only needed for privileged admin operations, not for verifying
# tokens the app sends.
FIREBASE_CREDENTIALS=./keys/firebase-adminsdk.json
FACILITY_API_KEYS=rs-harapan:abc123,rs-cipto:def456
OPERATOR_API_KEY=CHANGE_ME

# --- Misc ---
OLLAMA_URL=http://localhost:11434
CORS_ORIGINS=http://localhost,http://127.0.0.1
ORT_INTRA_OP_THREADS=4
