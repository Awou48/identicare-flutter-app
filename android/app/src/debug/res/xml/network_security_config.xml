<?xml version="1.0" encoding="utf-8"?>
<!--
  Konfigurasi DEBUG saja.

  Android 9+ memblokir HTTP cleartext secara default, sehingga
  http://192.168.x.x:8000 GAGAL DIAM-DIAM di ponsel modern walaupun izin
  INTERNET sudah ditambahkan. Ini mengizinkannya HANYA untuk alamat
  pengembangan - jangan pernah memakai android:usesCleartextTraffic="true"
  yang berlaku menyeluruh.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <!-- Alias emulator Android untuk localhost mesin host -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- Rentang LAN privat untuk perangkat fisik -->
        <domain includeSubdomains="true">192.168.0.0</domain>
        <domain includeSubdomains="true">192.168.1.0</domain>
        <domain includeSubdomains="true">10.0.0.0</domain>
    </domain-config>
</network-security-config>
