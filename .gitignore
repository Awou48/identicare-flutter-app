# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# --- Python backend (backend/.gitignore has the finer-grained rules) ---
backend/.venv/
backend/**/__pycache__/
backend/.pytest_cache/
backend/.ruff_cache/

# Secrets. Losing backend/keys/kek.bin makes every stored biometric template
# permanently unreadable, so it is backed up out of band, never committed.
backend/.env
backend/keys/

# Face ONNX models (~170 MB), downloaded manually. See backend/README.md.
backend/models/
*.onnx

# Android release signing
android/key.properties
